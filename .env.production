# ── GA4 Live Dashboard Connection ────────────────────────────────────────
# Set this to your deployed Cloudflare Worker URL to show live GA4 data.
# Leave blank or omit to show demo data.
#
# Example: VITE_GA4_WORKER_URL=https://ga4-analytics-api.your-subdomain.workers.dev
VITE_GA4_WORKER_URL=https://ga4-analytics-api.dadatadad-analytics.workers.dev

# ── PostHog Product Analytics ────────────────────────────────────────────
# Project API key from PostHog → Settings → Project → "Project API Key".
# Safe to commit: this is a publishable, client-side (write-only) key.
# Leave blank to disable PostHog — the app no-ops gracefully without it.
#
# Example: VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_POSTHOG_KEY=phc_D5VrXTidn7SKbKbDfZbWQVu4MZMzAogdLcC4d2dVuSpJ

# Ingestion host.  US Cloud: https://us.i.posthog.com  (default)
#                  EU Cloud: https://eu.i.posthog.com
#
# Ingestion goes through the managed reverse proxy on our own domain, so ad
# blockers that block *.posthog.com (a meaningful share of desktop visitors,
# and this audience skews technical) don't silently drop our analytics.
#
# The proxy is CNAME e -> 95a06bb59f9f6f9353e8.cf-prod-us-proxy.proxyhog.com.
# in cPanel → Zone Editor; PostHog issues and renews the cert. Verified
# 2026-09-12: /array/<token>/config.js, /static/**, and /e/ all route through
# it and match the behaviour of us.i.posthog.com.
#
# To roll back, set this to https://us.i.posthog.com — the CSP in
# public/.htaccess still allows both hosts.
VITE_POSTHOG_HOST=https://e.dadatadad.com

# UI host — where the toolbar / session-replay links point. Must stay the real
# PostHog app host even when VITE_POSTHOG_HOST is the proxy.
VITE_POSTHOG_UI_HOST=https://us.posthog.com
