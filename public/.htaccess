# ============================================================================
# .htaccess — Security & Performance Hardening for dadatadad.com
# Lives in public/, so Vite copies it into dist/ and CI uploads it to
# public_html on every push to master (.github/workflows/deploy.yml).
# ============================================================================

# ── 0. LET CERTIFICATE VALIDATION THROUGH ───────────────────────────────────
# This block must stay FIRST, above every other rewrite.
#
# To prove the site controls its domain, a certificate authority fetches a
# small file over plain HTTP from one of the paths below (this is how cPanel's
# AutoSSL validates). Every rule further down would interfere with that:
# section 1 redirects the request to HTTPS — which, once the certificate has
# lapsed, is exactly the thing that is broken — and section 8 would answer a
# missing file with index.html and a 200.
#
# ⚠ Necessary, but it was NOT what was blocking validation. On 2026-11-14 the
# site was found serving the host's default certificate (*.web-hosting.com)
# with all of these paths redirected, and this file was blamed. Measured on
# 2026-11-16 with this block deployed: over HTTPS they now answer 404, as
# intended, but over plain HTTP they are still redirected. The server redirects
# port 80 for this domain BEFORE it reads this file — a hosting setting, which
# nothing here can lift. (The outage was the certificate running out; a new one
# was installed with that redirect still on.) See CLAUDE.md, "Hosting and the
# certificate".
#
# cPanel can add exclusions like these to .htaccess on its own, but CI uploads
# this file whole whenever it changes, which overwrites anything added on the
# server. So they live here, in the source.
RewriteEngine On
RewriteRule ^\.well-known/ - [L]
RewriteRule ^[0-9]+\..+\.cpaneldcv$ - [L]
RewriteRule ^[A-F0-9]{32}\.txt$ - [L]

# ── 1. FORCE HTTPS ──────────────────────────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Also handle www → non-www (or vice versa — pick one and be consistent)
# Uncomment the version you want:
# www → non-www (canonical: dadatadad.com)
RewriteCond %{HTTP_HOST} ^www\.dadatadad\.com [NC]
RewriteRule ^(.*)$ https://dadatadad.com/$1 [L,R=301]

# ── 2. SECURITY HEADERS ────────────────────────────────────────────────────
<IfModule mod_headers.c>

  # Strict-Transport-Security: tell browsers to always use HTTPS
  # max-age=31536000 = 1 year; includeSubDomains covers all subdomains
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  # Prevent MIME-type sniffing (stops browsers from interpreting files as something else)
  Header always set X-Content-Type-Options "nosniff"

  # Clickjacking protection: only allow your own site to frame your pages
  Header always set X-Frame-Options "SAMEORIGIN"

  # XSS filter: belt-and-suspenders (modern browsers use CSP, but older ones use this)
  Header always set X-XSS-Protection "1; mode=block"

  # Referrer Policy: send origin only to external sites, full referrer to same-origin
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions Policy: disable browser features you don't use
  # Your site uses canvas + touch — keep those enabled; lock down everything else.
  # gyroscope/accelerometer are (self) because p5.js registers devicemotion +
  # deviceorientation listeners on every load; blocking them logged two
  # "Permissions policy violation" console errors into every page load, which
  # then polluted the console tab of every PostHog session replay.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(self), accelerometer=(self)"

  # Content-Security-Policy
  # Tuned for your stack: React/Vite (inline scripts from build), p5.js canvas,
  # PostHog (through the e.dadatadad.com proxy), Google Fonts, and your own assets.
  #
  # connect-src must list the analytics worker (analytics-worker/wrangler.toml,
  # VITE_ANALYTICS_API_URL). If the worker is ever renamed and this line is not
  # updated, the dashboards are blocked in production only — locally there is no
  # CSP, so it looks fine — and quietly fall back to sample data.
  Header always set Content-Security-Policy "\
    default-src 'self'; \
    script-src 'self' 'unsafe-inline' 'unsafe-eval' https://us-assets.i.posthog.com https://e.dadatadad.com; \
    style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; \
    font-src 'self' https://fonts.gstatic.com; \
    img-src 'self' data: https://us-assets.i.posthog.com https://e.dadatadad.com; \
    connect-src 'self' https://site-analytics.dadatadad-analytics.workers.dev https://us.i.posthog.com https://us-assets.i.posthog.com https://e.dadatadad.com; \
    worker-src 'self' blob:; \
    frame-ancestors 'self'; \
    base-uri 'self'; \
    form-action 'self'; \
    object-src 'none'"

  # Prevent browsers from caching sensitive pages if you ever add auth
  Header always set X-Permitted-Cross-Domain-Policies "none"

  # Remove server version info (Apache often leaks this)
  Header always unset X-Powered-By
  Header unset Server

</IfModule>

# ── 3. DISABLE DIRECTORY LISTING ───────────────────────────────────────────
Options -Indexes

# ── 4. BLOCK ACCESS TO SENSITIVE FILES ─────────────────────────────────────
# Prevent access to dotfiles (.git, .env, .htaccess itself, etc.)
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Block specific files that should never be publicly accessible
<FilesMatch "(package\.json|package-lock\.json|\.cpanel\.yml|vite\.config\.js|\.env|\.gitignore|README\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Block source map files from being served in production
<FilesMatch "\.map$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ── 5. BLOCK COMMON ATTACK PATHS ──────────────────────────────────────────
# Block access to paths commonly probed by bots (wp-admin, phpMyAdmin, etc.)
RewriteRule ^(wp-admin|wp-login|wp-content|wp-includes|xmlrpc\.php|administrator|phpmyadmin|mysql|sql|backup) - [R=404,L]

# Block suspicious query strings (SQL injection, script injection attempts)
RewriteCond %{QUERY_STRING} (<script|union.*select|insert.*into|delete.*from|drop.*table) [NC]
RewriteRule .* - [F,L]

# ── 6. CACHE CONTROL FOR STATIC ASSETS ────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # Hashed assets (Vite adds content hashes to filenames: main-C-O1Lkxf.js)
  # These are safe to cache aggressively since the hash changes on every build
  <FilesMatch "\.(js|css)$">
    ExpiresDefault "access plus 1 year"
    <IfModule mod_headers.c>
      Header set Cache-Control "public, max-age=31536000, immutable"
    </IfModule>
  </FilesMatch>

  # Images — cache for 30 days (your project images rarely change)
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    ExpiresDefault "access plus 1 month"
    <IfModule mod_headers.c>
      Header set Cache-Control "public, max-age=2592000"
    </IfModule>
  </FilesMatch>

  # Fonts — cache for 1 year
  <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
    ExpiresDefault "access plus 1 year"
    <IfModule mod_headers.c>
      Header set Cache-Control "public, max-age=31536000, immutable"
    </IfModule>
  </FilesMatch>

  # HTML — don't cache (so users always get the latest build)
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    <IfModule mod_headers.c>
      Header set Cache-Control "no-cache, no-store, must-revalidate"
      Header set Pragma "no-cache"
    </IfModule>
  </FilesMatch>

  # XML (sitemap) — cache for 1 day
  <FilesMatch "\.xml$">
    ExpiresDefault "access plus 1 day"
    <IfModule mod_headers.c>
      Header set Cache-Control "public, max-age=86400"
    </IfModule>
  </FilesMatch>
</IfModule>

# ── 7. COMPRESSION ─────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/font-woff application/font-woff2
</IfModule>

# ── 8. SPA FALLBACK ────────────────────────────────────────────────────────
# If a requested file/directory doesn't exist, serve index.html
# (needed if you ever add client-side routing)
# Exclude known HTML pages so they serve directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/analytics-dashboard\.html
RewriteCond %{REQUEST_URI} !^/analytics-v2\.html
RewriteCond %{REQUEST_URI} !^/portfolio\.html
RewriteCond %{REQUEST_URI} !^/sitemap\.xml
RewriteCond %{REQUEST_URI} !^/robots\.txt
# Never rewrite asset requests. Without this, a missing /assets/** file returns
# 200 + index.html, which means a typo'd image or a stale hashed bundle looks
# like a successful HTML response instead of a 404 -- p5's loadImage then fails
# on "image" data that is really a web page, and crawlers see soft-404s. Let
# assets 404 honestly.
RewriteCond %{REQUEST_URI} !^/assets/
RewriteRule ^(.*)$ /index.html [L]
